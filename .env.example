# Copy to .env (gitignored) and fill in real values.
# Then run with:  flutter run --dart-define-from-file=.env

# Supabase project (Dashboard → Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Google Maps (Cloud Console → APIs & Services → Credentials)
GOOGLE_MAPS_API_KEY=

# OneSignal (dashboard.onesignal.com). Leave blank to disable push.
ONESIGNAL_APP_ID=

# Dev-only: set to true to bypass the 2FA OTP step on login.
# auth.signInWithPassword is called directly from the client; the
# production login edge function is unchanged. Never set in release.
DEV_SKIP_2FA=false

# ─────────────────────────────────────────────────────────────
# DO NOT add server-only secrets to this file. The Flutter build
# embeds every value referenced via String.fromEnvironment into
# the shipped bundle.
#
#   SUPABASE_SERVICE_ROLE_KEY  → admin-dashboard/.env.local
#   ADMIN_USERNAME/PASSWORD    → admin-dashboard/.env.local
#   SHUFTIPRO_CLIENT_ID/SECRET → Supabase edge function secrets
#                                (`supabase secrets set ...`)
# ─────────────────────────────────────────────────────────────
